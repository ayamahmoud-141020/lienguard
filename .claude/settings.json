{
  "enabledPlugins": {
    "factory@ignteq-factory": false
  },
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm samples)",
      "Bash(pnpm build)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.env*)",
      "Write(.env.local)",
      "Write(.env)",
      "Read(.env.local)",
      "Read(.env)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Read(~/.ssh/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(cat .env*)"
    ]
  }
}
